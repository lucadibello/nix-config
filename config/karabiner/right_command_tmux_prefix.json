{
  "description": "Map right command to tmux prefix (Control+B)",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "right_command",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "b",
          "modifiers": ["left_control"]
        }
      ]
    }
  ]
}
